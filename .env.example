# ============================================================================
# Puja Platform – User Website Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) before running `npm run dev`
# ============================================================================

# Base URL of the Puja Platform Express REST API (including `/api`)
VITE_API_URL=http://localhost:5000/api

# Base URL of the Socket.io server for live booking & pandit assignment updates
VITE_SOCKET_URL=http://localhost:5000
